# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# Local MongoDB: mongodb://127.0.0.1:27017/placement_prep
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/placement_prep?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/placement_prep

# Authentication (JWT)
JWT_SECRET=super_secret_placement_prep_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Google Gemini AI API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
